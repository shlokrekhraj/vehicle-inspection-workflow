# Managed by Ansible - do not edit by hand
APP_PORT={{ app_port | string | quote }}
APP_ENV={{ app_env | quote }}
DB_URL={{ ('jdbc:mysql://' ~ db_container ~ ':3306/' ~ db_name ~ '?createDatabaseIfNotExist=true') | quote }}
DB_USERNAME={{ db_user | quote }}
DB_PASSWORD={{ db_password | quote }}
JAVA_OPTS={{ java_opts | quote }}
