#!/bin/sh
### BEGIN INIT INFO
# Provides:          {{ app_name }}
# Required-Start:    $remote_fs $network
# Required-Stop:     $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Vehicle Inspection Workflow (Spring Boot)
### END INIT INFO
# Managed by Ansible - do not edit by hand

NAME={{ app_name }}
APP_HOME={{ app_home }}
JAR="$APP_HOME/current/app.jar"
PIDFILE=/var/run/$NAME.pid
LOG="$APP_HOME/logs/app.log"
ENV_FILE={{ app_conf_dir }}/app.env
RUN_AS={{ app_user }}

is_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
    if is_running; then
        echo "$NAME is already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    if [ ! -f "$JAR" ]; then
        echo "No release deployed at $JAR"
        return 1
    fi
    set -a; . "$ENV_FILE"; set +a
    start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
        --chuid "$RUN_AS" --chdir "$APP_HOME" \
        --startas /bin/sh -- -c "exec java $JAVA_OPTS -jar $JAR >> $LOG 2>&1"
    echo "Started $NAME ($(readlink -f "$APP_HOME/current"))"
}

stop() {
    if ! is_running; then
        echo "$NAME is not running"
        rm -f "$PIDFILE"
        return 0
    fi
    start-stop-daemon --stop --pidfile "$PIDFILE" --retry TERM/20/KILL/5 --remove-pidfile
    echo "Stopped $NAME"
}

status() {
    if is_running; then
        echo "$NAME is running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    echo "$NAME is not running"
    return 3
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    status)  status ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 2 ;;
esac
